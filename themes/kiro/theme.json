{
  "schemaVersion": 1,
  "name": "Kiro Face",
  "author": "Based on Kiro Avatar Design",
  "version": "1.0.0",
  "description": "A cute blue circular face with expressive eyes and gradient border",
  "license": "MIT",

  "viewBox": {
    "x": -15,
    "y": -25,
    "width": 45,
    "height": 45
  },

  "eyeTracking": {
    "enabled": true,
    "states": ["idle"],
    "eyeRatioX": 0.5,
    "eyeRatioY": 0.4,
    "maxOffset": 3,
    "bodyScale": 0.33,
    "shadowStretch": 0.15,
    "shadowShift": 0.3,
    "ids": {
      "eyes": "eyes-js",
      "body": "body-js",
      "shadow": "shadow-js"
    },
    "shadowOrigin": "7.5px 15px"
  },

  "states": {
    "idle": ["idle-follow.svg"],
    "thinking": ["thinking.svg"],
    "working": ["typing.svg"],
    "error": ["error.svg"],
    "attention": ["happy.svg"],
    "notification": ["notification.svg"],
    "sleeping": ["sleeping.svg"],
    "waking": ["waking.svg"],
    "yawning": ["yawning.svg"],
    "sweeping": ["sweeping.svg"],
    "carrying": ["carrying.svg"]
  },

  "workingTiers": [
    { "minSessions": 3, "file": "building.svg" },
    { "minSessions": 2, "file": "juggling.svg" },
    { "minSessions": 1, "file": "typing.svg" }
  ],

  "idleAnimations": [
    { "file": "idle-look.svg", "duration": 3000 }
  ],

  "timings": {
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  },

  "hitBoxes": {
    "default": { "x": -1, "y": 5, "w": 17, "h": 12 },
    "sleeping": { "x": -2, "y": 9, "w": 19, "h": 7 }
  },
  "sleepingHitboxFiles": ["sleeping.svg"],

  "reactions": {
    "drag": { "file": "react-drag.svg" },
    "clickLeft": { "file": "react-left.svg", "duration": 2500 },
    "clickRight": { "file": "react-right.svg", "duration": 2500 },
    "double": { "files": ["react-double.svg"], "duration": 3500 }
  },

  "miniMode": {
    "supported": false
  },

  "objectScale": {
    "widthRatio": 1.9,
    "heightRatio": 1.3,
    "offsetX": -0.45,
    "offsetY": -0.25
  }
}
